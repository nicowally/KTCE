<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gamehub.games.chess.ChessController">
    <top>
        <VBox alignment="CENTER_LEFT" style="-fx-padding: 15;">
         <children>
            <Button mnemonicParsing="false" onAction="#onBackClick" text="Zurück" />
         </children>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="chessBoardPane" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
