<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: #0d0d1a;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gamehub.gamehub.Connect4Controller">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 14 20 14 20; -fx-background-color: #13132a;
                     -fx-border-color: #2a2a4a; -fx-border-width: 0 0 1 0;">
            <Button mnemonicParsing="false" onAction="#onBackClick" text="← Zurück"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 12;
                           -fx-border-color: #3a3a5c; -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;" />
            <Label fx:id="titleLabel" text="4-Gewinnt"
                   style="-fx-text-fill: white; -fx-font-size: 22px;
                          -fx-font-weight: bold; -fx-padding: 0 0 0 8;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRulesClick" text="📋 Regeln"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 14;
                           -fx-border-color: #3a3a5c; -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;" />
        </HBox>
    </top>

    <center>
        <!-- StackPane lets the lobby overlay sit on top of the game content -->
        <StackPane>

            <!-- ── Game content (always present in the scene graph) ── -->
            <ScrollPane fx:id="gamePane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <VBox alignment="CENTER" spacing="12"
                          style="-fx-background-color: #0d0d1a;">
                        <padding><Insets top="24" bottom="40" left="40" right="40" /></padding>

                        <Label fx:id="statusLabel"
                               text="🔴  Rot ist dran"
                               style="-fx-text-fill: #e74c3c; -fx-font-size: 26px; -fx-font-weight: bold;" />

                        <HBox alignment="CENTER">
                            <VBox alignment="CENTER" spacing="0">
                                <HBox fx:id="dropButtonBar" alignment="CENTER" spacing="0">
                                    <Button fx:id="col0" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col1" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col2" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col3" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col4" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col5" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                    <Button fx:id="col6" onAction="#onColumnClick" text="▼"
                                            minWidth="80" prefWidth="80" maxWidth="80"
                                            style="-fx-font-size: 16px; -fx-background-color: transparent;
                                                   -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                </HBox>

                                <Pane fx:id="boardWrapper">
                                    <GridPane fx:id="boardGrid"
                                              hgap="0" vgap="0"
                                              style="-fx-background-color: #0a1628;
                                                     -fx-padding: 8;
                                                     -fx-background-radius: 10;">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                            <ColumnConstraints minWidth="80" prefWidth="80" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                            <RowConstraints minHeight="80" prefHeight="80" />
                                        </rowConstraints>
                                    </GridPane>
                                </Pane>
                            </VBox>
                        </HBox>

                        <Button fx:id="restartBtn" mnemonicParsing="false" onAction="#onRestartClick" text="Neu starten"
                                style="-fx-font-size: 15px; -fx-padding: 10 28;
                                       -fx-background-color: #1e1e3a; -fx-text-fill: #aaaacc;
                                       -fx-background-radius: 8; -fx-border-color: #3a3a5c;
                                       -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand;" />
                    </VBox>
                </content>
            </ScrollPane>

            <!-- ── Lobby overlay (visible only in LAN mode, before connection) ── -->
            <VBox fx:id="lobbyPane" alignment="CENTER" spacing="20"
                  visible="false" managed="false"
                  style="-fx-background-color: #0d0d1a;">
                <padding><Insets top="60" bottom="60" left="80" right="80"/></padding>

                <Label text="LAN-Spiel"
                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>

                <HBox alignment="CENTER" spacing="16">
                    <Button fx:id="hostBtn" onAction="#onHostClick" text="Spiel hosten"
                            style="-fx-font-size: 15px; -fx-padding: 12 30;
                                   -fx-background-color: #1a4a8a; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-cursor: hand;"/>
                    <Button fx:id="joinBtn" onAction="#onJoinClick" text="Spiel beitreten"
                            style="-fx-font-size: 15px; -fx-padding: 12 30;
                                   -fx-background-color: #1e6b1e; -fx-text-fill: white;
                                   -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>

                <HBox fx:id="ipBox" alignment="CENTER" spacing="10" visible="false" managed="false">
                    <TextField fx:id="ipField" promptText="IP-Adresse des Hosts"
                               style="-fx-background-color: #1e1e3a; -fx-text-fill: white;
                                      -fx-font-size: 14px; -fx-padding: 8 14;
                                      -fx-background-radius: 6; -fx-border-color: #3a3a5c;
                                      -fx-border-radius: 6; -fx-border-width: 1;"
                               prefWidth="240"/>
                    <Button fx:id="connectBtn" onAction="#onConnectClick" text="Verbinden"
                            style="-fx-font-size: 14px; -fx-padding: 8 20;
                                   -fx-background-color: #3a5a9a; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <Label fx:id="lobbyStatus" text=""
                       style="-fx-text-fill: #aaaacc; -fx-font-size: 14px;"/>
            </VBox>

        </StackPane>
    </center>
</BorderPane>