<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gamehub.gamehub.TicTacToeController">

    <top>
        <VBox alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-padding: 15;">
            <children>
                <Button mnemonicParsing="false" onAction="#onBackClick" text="Zurück" />
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER" spacing="16.0" BorderPane.alignment="CENTER">
                    <padding><Insets top="20" bottom="40" left="40" right="40" /></padding>

                    <!-- Status label -->
                    <Label fx:id="statusLabel"
                           text="Spieler X ist dran"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" />

                    <!-- ── AI-only controls ─────────────────────────────────────────────── -->

                    <!-- Side selection buttons (hidden in 2-player mode) -->
                    <HBox fx:id="sideSelectionBox"
                          alignment="CENTER" spacing="20"
                          visible="false" managed="false">
                        <Button fx:id="playerSideBtn"
                                text="Spieler   X"
                                onAction="#onPlayerSideBtnClick"
                                style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-background-color: #4a90d9; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 24;" />
                        <Button fx:id="aiSideBtn"
                                text="KI   O"
                                onAction="#onAiSideBtnClick"
                                style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-background-color: #3a3a5c; -fx-text-fill: #aaaaaa; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 24;" />
                    </HBox>

                    <!-- Difficulty slider (hidden in 2-player mode) -->
                    <VBox fx:id="difficultyBox"
                          alignment="CENTER" spacing="6"
                          visible="false" managed="false">
                        <Label text="Schwierigkeit"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 13px;" />
                        <Slider fx:id="difficultySlider"
                                min="0" max="100" value="100"
                                showTickLabels="false" showTickMarks="false"
                                prefWidth="320"
                                style="-fx-accent: #4a90d9;" />
                        <Label fx:id="difficultyLabel"
                               text="Unschlagbar"
                               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    </VBox>

                    <!-- ── Game board ───────────────────────────────────────────────────── -->

                    <GridPane fx:id="boardGrid"
                              hgap="8" vgap="8"
                              alignment="CENTER"
                              VBox.vgrow="ALWAYS"
                              maxWidth="Infinity" maxHeight="Infinity"
                              style="-fx-padding: 10;">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="ALWAYS" percentHeight="33.33" />
                            <RowConstraints vgrow="ALWAYS" percentHeight="33.33" />
                            <RowConstraints vgrow="ALWAYS" percentHeight="33.34" />
                        </rowConstraints>
                        <children>
                            <Button fx:id="cell0" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Button fx:id="cell1" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Button fx:id="cell2" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Button fx:id="cell3" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Button fx:id="cell4" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Button fx:id="cell5" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <Button fx:id="cell6" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Button fx:id="cell7" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Button fx:id="cell8" onAction="#onCellClick" maxWidth="Infinity" maxHeight="Infinity"
                                    style="-fx-font-size: 60px; -fx-font-weight: bold; -fx-background-color: #778CA1; -fx-text-fill: white; -fx-cursor: hand;"
                                    GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        </children>
                    </GridPane>

                    <Button mnemonicParsing="false" onAction="#onRestartClick" text="Neu starten"
                            style="-fx-font-size: 18px; -fx-padding: 10 30;" />
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>