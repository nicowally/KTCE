<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: #0d0d1a;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gamehub.gamehub.Connect4Controller">

    <!-- ── Top bar ─────────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 14 20 14 20; -fx-background-color: #13132a;
                     -fx-border-color: #2a2a4a; -fx-border-width: 0 0 1 0;">
            <Button mnemonicParsing="false" onAction="#onBackClick" text="← Zurück"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 12;
                           -fx-border-color: #3a3a5c; -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;" />
            <Label text="4-Gewinnt"
                   style="-fx-text-fill: white; -fx-font-size: 22px;
                          -fx-font-weight: bold; -fx-padding: 0 0 0 8;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRulesClick" text="📋 Regeln"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb;
                           -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 14;
                           -fx-border-color: #3a3a5c; -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;" />
        </HBox>
    </top>

    <!-- ── Centre ──────────────────────────────────────────────────────────── -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color: #0d0d1a;">
                    <padding><Insets top="24" bottom="40" left="40" right="40" /></padding>

                    <!-- Status label -->
                    <Label fx:id="statusLabel"
                           text="🔴  Rot ist dran"
                           style="-fx-text-fill: #e74c3c; -fx-font-size: 26px; -fx-font-weight: bold;" />

                    <!-- Drop buttons + board wrapped together so arrows align with columns -->
                    <HBox alignment="CENTER">
                        <VBox alignment="CENTER" spacing="0">

                            <!-- Drop buttons — each exactly 80px wide, matching column width -->
                            <HBox fx:id="dropButtonBar" alignment="CENTER" spacing="0">
                                <Button fx:id="col0" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col1" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col2" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col3" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col4" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col5" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                                <Button fx:id="col6" onAction="#onColumnClick" text="▼"
                                        minWidth="80" prefWidth="80" maxWidth="80"
                                        style="-fx-font-size: 16px; -fx-background-color: transparent;
                                               -fx-text-fill: #555577; -fx-cursor: hand; -fx-padding: 4 0;" />
                            </HBox>

                            <!-- boardGrid inside a Pane for win-line absolute positioning -->
                            <Pane fx:id="boardWrapper">
                                <GridPane fx:id="boardGrid"
                                          hgap="0" vgap="0"
                                          style="-fx-background-color: #0a1628;
                                                 -fx-padding: 8;
                                                 -fx-background-radius: 10;">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                        <ColumnConstraints minWidth="80" prefWidth="80" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                        <RowConstraints minHeight="80" prefHeight="80" />
                                    </rowConstraints>
                                    <!-- Cells added programmatically in the controller -->
                                </GridPane>
                                <!-- Win-line added at runtime by the controller -->
                            </Pane>

                        </VBox>
                    </HBox>

                    <!-- Restart button -->
                    <Button mnemonicParsing="false" onAction="#onRestartClick" text="Neu starten"
                            style="-fx-font-size: 15px; -fx-padding: 10 28;
                                   -fx-background-color: #1e1e3a; -fx-text-fill: #aaaacc;
                                   -fx-background-radius: 8; -fx-border-color: #3a3a5c;
                                   -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand;" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
