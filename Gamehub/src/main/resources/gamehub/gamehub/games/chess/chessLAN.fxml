<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" style="-fx-background-color: #1a1a2e;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gamehub.games.chess.network.ChessLanController">

    <center>
        <VBox alignment="CENTER" spacing="30">
            <padding><Insets top="60" bottom="60" left="80" right="80"/></padding>

            <Label text="Schach — LAN" textFill="WHITE">
                <font><Font name="System Bold" size="28"/></font>
            </Label>

            <!-- HOST-BEREICH -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: #2a2a4e; -fx-background-radius: 10; -fx-padding: 20;">

                <Label text="Spiel hosten" textFill="WHITE">
                    <font><Font name="System Bold" size="16"/></font>
                </Label>
                <Label fx:id="hostInfoLabel" textFill="#aaaaaa" wrapText="true" alignment="CENTER"/>
                <Button fx:id="hostButton" text="Hosten" onAction="#onHostClick"
                        prefWidth="200" style="-fx-background-color: #4e7837; -fx-text-fill: white;"/>
            </VBox>

            <!-- BEITRETEN-BEREICH -->
            <VBox alignment="CENTER" spacing="10"
                  style="-fx-background-color: #2a2a4e; -fx-background-radius: 10; -fx-padding: 20;">

                <Label text="Spiel beitreten" textFill="WHITE">
                    <font><Font name="System Bold" size="16"/></font>
                </Label>
                <TextField fx:id="ipField" promptText="IP-Adresse eingeben"
                           prefWidth="200" style="-fx-background-color: #3a3a5e; -fx-text-fill: white;"/>
                <Button fx:id="joinButton" text="Beitreten" onAction="#onJoinClick"
                        prefWidth="200" style="-fx-background-color: #4e7837; -fx-text-fill: white;"/>
                <Label fx:id="joinStatusLabel" textFill="#ff6666" wrapText="true" alignment="CENTER"/>
            </VBox>

            <!-- ZURÜCK -->
            <Button text="Zurück" onAction="#onBackClick"
                    style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-border-color: #aaaaaa; -fx-border-radius: 5;"/>
        </VBox>
    </center>
</BorderPane>