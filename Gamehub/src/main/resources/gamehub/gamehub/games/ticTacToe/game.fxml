<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: #0d0d1a;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gamehub.gamehub.TicTacToeController">

    <!-- ── Top bar ─────────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding: 14 20 14 20; -fx-background-color: #13132a; -fx-border-color: #2a2a4a; -fx-border-width: 0 0 1 0;">
            <Button fx:id="backBtn" mnemonicParsing="false" onAction="#onBackClick" text="← Zurück"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 12; -fx-border-color: #3a3a5c; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" />
            <Label text="Tic-Tac-Toe"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 0 0 8;" />
            <!-- Spacer -->
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="rulesBtn" mnemonicParsing="false" onAction="#onRulesClick" text="📋 Regeln"
                    style="-fx-background-color: transparent; -fx-text-fill: #8888bb; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 6 14; -fx-border-color: #3a3a5c; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6;" />
        </HBox>
    </top>

    <!-- ── Centre ──────────────────────────────────────────────────────────── -->
    <center>
        <VBox alignment="CENTER" spacing="20"
              style="-fx-padding: 24 40 32 40; -fx-background-color: #0d0d1a;">

            <!-- Status label -->
            <Label fx:id="statusLabel"
                   text="Spieler X ist dran"
                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />

            <!-- ── AI controls ──────────────────────────────────────────────── -->
            <HBox fx:id="sideSelectionBox" alignment="CENTER" spacing="16"
                  visible="false" managed="false">
                <Button fx:id="playerSideBtn" text="Spieler  X" onAction="#onPlayerSideBtnClick"
                        style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #4a90d9; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 9 22;" />
                <Button fx:id="aiSideBtn" text="KI  O" onAction="#onAiSideBtnClick"
                        style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-background-color: #2a2a4a; -fx-text-fill: #8888bb; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 9 22;" />
            </HBox>

            <VBox fx:id="difficultyBox" alignment="CENTER" spacing="5"
                  visible="false" managed="false">
                <Label text="Schwierigkeit"
                       style="-fx-text-fill: #6666aa; -fx-font-size: 12px;" />
                <Slider fx:id="difficultySlider" min="0" max="100" value="100"
                        prefWidth="280"
                        style="-fx-accent: #4a90d9;" />
                <Label fx:id="difficultyLabel" text="Unschlagbar"
                       style="-fx-text-fill: #aaaacc; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>

            <!-- ── Board ────────────────────────────────────────────────────── -->
            <!--
                boardGrid lives inside a Pane (fx:id="boardWrapper") so the
                win-line Line can be added with absolute coordinates matching
                the grid. A Pane does NOT centre its children like StackPane does.
            -->
            <HBox alignment="CENTER">
                <Pane fx:id="boardWrapper">
                    <GridPane fx:id="boardGrid"
                              hgap="0" vgap="0"
                              alignment="CENTER"
                              style="-fx-padding: 0;">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" prefWidth="140" maxWidth="180" />
                            <ColumnConstraints minWidth="120" prefWidth="140" maxWidth="180" />
                            <ColumnConstraints minWidth="120" prefWidth="140" maxWidth="180" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="120" prefHeight="140" maxHeight="180" />
                            <RowConstraints minHeight="120" prefHeight="140" maxHeight="180" />
                            <RowConstraints minHeight="120" prefHeight="140" maxHeight="180" />
                        </rowConstraints>
                        <!-- Cells added programmatically in TicTacToeController -->
                    </GridPane>
                    <!-- Win-line Line nodes added here at runtime by the controller -->
                </Pane>
            </HBox>

            <!-- ── Bottom buttons ───────────────────────────────────────────── -->
            <HBox alignment="CENTER" spacing="16">
                <Button mnemonicParsing="false" onAction="#onRestartClick" text="Neu starten"
                        style="-fx-font-size: 15px; -fx-padding: 10 28; -fx-background-color: #1e1e3a; -fx-text-fill: #aaaacc; -fx-background-radius: 8; -fx-border-color: #3a3a5c; -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand;" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
